/proyecto/sphaera/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; img-src 'self' data:; connect-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()

/proyecto/sphaera/media/*
  Cache-Control: public, max-age=31536000, immutable

/proyecto/sphaera/fonts/*
  Cache-Control: public, max-age=31536000, immutable
