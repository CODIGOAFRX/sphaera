{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "sphaera",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  // Sólo archivos estáticos: las escenas funcionan en el navegador.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "pedrogomez.dev/proyecto/sphaera", "zone_name": "pedrogomez.dev" },
    { "pattern": "pedrogomez.dev/proyecto/sphaera/*", "zone_name": "pedrogomez.dev" },
    { "pattern": "www.pedrogomez.dev/proyecto/sphaera", "zone_name": "pedrogomez.dev" },
    { "pattern": "www.pedrogomez.dev/proyecto/sphaera/*", "zone_name": "pedrogomez.dev" }
  ]
}
